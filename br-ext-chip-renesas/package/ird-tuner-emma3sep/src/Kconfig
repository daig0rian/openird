config IRD_TUNER_EMMA3SEP
	bool "Renesas EMMA3SEP TS capture (AV sub-CPU commands, TS input FIFOs)"
	depends on EMMA3SX
	help
	  The command path to the firmware of the SoC's AV sub-CPU and the
	  drainer of the transport stream input FIFOs in its data SRAM.
	  Board tuner drivers select this.

config IRD_TUNER_EMMA3SEP_BOARDS
	bool
	select IRD_TUNER_CORE
	select IRD_TUNER_EMMA3SEP
	help
	  The tuner of the EMMA3SEP boards (/dev/irdvideo0): the SoC side is
	  shared, the front end is the one of the board the boot loader
	  names.  Selected by the boards' front ends below.

config IRD_TUNER_YB1
	bool "POE-BR100-YB1 (BMMPX1301) tuner"
	depends on EMMA3SX && I2C
	select IRD_TUNER_EMMA3SEP_BOARDS
	select IRD_TUNER_MXL683
	help
	  The front end of the POE-BR100-YB1: the MXL683 demodulator.
	  Inactive on other boards of the family.

config IRD_TUNER_WRIP
	bool "SB-TV06-WRIP (POE-BR310L-SB1) tuner"
	depends on EMMA3SX && I2C && GPIOLIB
	select IRD_TUNER_EMMA3SEP_BOARDS
	help
	  The front end of the SB-TV06-WRIP: TC90532 demodulator with the
	  MxL601RF and TDA8263HN tuners, terrestrial reception.  Inactive
	  on other boards of the family.
