From: OpenIRD contributors
Subject: [PATCH] mips: mm: set the room for clear_page/copy_page aside in assembler

page.c generates clear_page() and copy_page() at boot into two static
arrays, and gives the arrays their function names with

  void clear_page(void *page) __attribute__((alias("clear_page_array")));

gcc 4.9 rejects that:

  arch/mips/mm/page.c:88:6: error: 'clear_page' alias in between function
                                   and variable is not supported

Reserve the two blocks in a small assembler file instead, where one address
can carry both the object symbol page.c writes through and the function
symbol everyone else calls.  The generator itself is untouched, and so are
the block sizes; the only difference at run time is that the routines now
sit in .text rather than .bss.

Mainline later solved the same problem the same way (arch/mips/mm/
page-funcs.S).  This is written for this tree, not copied from there.

Origin: gpl-derived
---
--- a/arch/mips/mm/Makefile
+++ b/arch/mips/mm/Makefile
@@ -3,7 +3,8 @@
 #
 
 obj-y				+= cache.o dma-default.o extable.o fault.o \
-				   init.o tlbex.o tlbex-fault.o uasm.o page.o
+				   init.o tlbex.o tlbex-fault.o uasm.o page.o \
+				   page-funcs.o
 
 obj-$(CONFIG_32BIT)		+= ioremap.o pgtable-32.o
 obj-$(CONFIG_64BIT)		+= pgtable-64.o
--- a/arch/mips/mm/page-funcs.S
+++ b/arch/mips/mm/page-funcs.S
@@ -0,0 +1,42 @@
+/*
+ * Room for the clear_page and copy_page routines.
+ *
+ * arch/mips/mm/page.c synthesises both for the running CPU at boot
+ * (build_clear_page / build_copy_page) and writes the instructions here.
+ * Each block is known under two names: the array page.c fills, and the
+ * function the rest of the kernel calls.  The sizes are the maxima worked
+ * out in page.c.
+ *
+ * This file is subject to the terms and conditions of the GNU General Public
+ * License.  See the file "COPYING" in the main directory of this archive
+ * for more details.
+ */
+#include <asm/asm.h>
+
+#ifdef CONFIG_SIBYTE_DMA_PAGEOPS
+#define CLEAR_PAGE_FN	clear_page_cpu
+#define COPY_PAGE_FN	copy_page_cpu
+#else
+#define CLEAR_PAGE_FN	clear_page
+#define COPY_PAGE_FN	copy_page
+#endif
+
+	.text
+
+	.align	5
+	.globl	clear_page_array
+	.globl	CLEAR_PAGE_FN
+	.type	CLEAR_PAGE_FN, @function
+clear_page_array:
+CLEAR_PAGE_FN:
+	.space	0x120
+	.size	CLEAR_PAGE_FN, . - CLEAR_PAGE_FN
+
+	.align	5
+	.globl	copy_page_array
+	.globl	COPY_PAGE_FN
+	.type	COPY_PAGE_FN, @function
+copy_page_array:
+COPY_PAGE_FN:
+	.space	0x540
+	.size	COPY_PAGE_FN, . - COPY_PAGE_FN
--- a/arch/mips/mm/page.c
+++ b/arch/mips/mm/page.c
@@ -80,12 +80,17 @@
  * With prefetching, 16 word strides	0x120 bytes
  */
 
-static u32 clear_page_array[0x120 / 4];
+/*
+ * The room for the routine is set aside in page-funcs.S, where the same
+ * address also carries the function symbol (clear_page, or clear_page_cpu
+ * with CONFIG_SIBYTE_DMA_PAGEOPS).  It used to be an array here with the
+ * function declared as an alias of it; gcc 4.9 and later refuse an alias
+ * between a function and a variable.
+ */
+extern u32 clear_page_array[0x120 / 4];
 
 #ifdef CONFIG_SIBYTE_DMA_PAGEOPS
-void clear_page_cpu(void *page) __attribute__((alias("clear_page_array")));
-#else
-void clear_page(void *page) __attribute__((alias("clear_page_array")));
+extern void clear_page_cpu(void *page);
 #endif
 
 EXPORT_SYMBOL(clear_page);
@@ -98,13 +103,10 @@
  * R4600 v2.0:				0x07c bytes
  * With prefetching, 16 word strides	0x540 bytes
  */
-static u32 copy_page_array[0x540 / 4];
+extern u32 copy_page_array[0x540 / 4];	/* in page-funcs.S, as above */
 
 #ifdef CONFIG_SIBYTE_DMA_PAGEOPS
-void
-copy_page_cpu(void *to, void *from) __attribute__((alias("copy_page_array")));
-#else
-void copy_page(void *to, void *from) __attribute__((alias("copy_page_array")));
+extern void copy_page_cpu(void *to, void *from);
 #endif
 
 EXPORT_SYMBOL(copy_page);
