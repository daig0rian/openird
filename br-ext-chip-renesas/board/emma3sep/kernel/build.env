# SPDX-License-Identifier: GPL-2.0-only
# emma3sep（POE-BR100-YB1・SB-TV06-WRIP）の再現ビルドの固定物。
# scripts/build-kernel.sh（カーネル本体＝uImage）と scripts/build-yb1-kmod.sh
# （ベンダカーネル向けのモジュール）が `.` で読む。
# 値にスペース/括弧/グロブを含むものは必ずクォートする。

ARCH=mips
KERNEL_VERSION=2.6.27.39
KERNEL_TOP=linux-2.6.27.39
KERNEL_IMAGE_TARGET=vmlinux
# 純正 U-Boot が食う形（Legacy uImage・gzip）。契約は boards/poe-br100-yb1.json の "uimage"
KERNEL_PACK=uimage
# カーネルを梱包するときの openird-mkimage の board 名（host/openird-mkimage/boards/<MKIMAGE_BOARD>.json）。
# uImage の契約はファミリー共通（SB-TV06-WRIP も同じ値）なので、代表の 1 機種を指す。factory と
# sysupgrade は、機種名から board 名を決める（scripts/make-factory.sh・make-sysupgrade.sh）
MKIMAGE_BOARD=poe-br100-yb1

# --- GPL カーネルソース（Pixela の公開 GPL ページから取得可・sha256 で pin） ---
# 公開ページ: https://www.pixela.co.jp/gpl/bmmpx1301/ （「地デジチューナー(R)」＝EMMA3SEP AirTuner）
# EMMA3SEP 系（POE-BR100-YB1 / POE-BR310L-SB1=SB-TV06-WRIP / retail PIX-BR310L/W）は
# 全部この 1 本の r557 ドロップ（2026-09-26 に DL・sha256 一致を確認）。frontend/demod/tuner の
# ソースはこの GPL には含まれない（全 26,583 ファイルで 0 件・観察で補う）。
KERNEL_TARBALL=Linux_kernel_2.6.27.39_r557_001.001.008-r06.tar.bz2
KERNEL_URL=https://www.pixela.co.jp/gpl/bmmpx1301/data/Linux_kernel_2.6.27.39_r557_001.001.008-r06.tar.bz2
KERNEL_SHA256=58c2259121c90191c92da2879b674d73cf34f59d224e24b8da3ef988719273f6
KERNEL_SRC_NOTE="GPL source for EMMA3SEP AirTuner (Pixela /gpl/bmmpx1301/). Auto-fetched by scripts; integrity pinned by KERNEL_SHA256."
# ビルド設定の出発点は GPL ドロップ同梱の `.config`（tarball の linux-2.6.27.39/ 直下。
# 実機の /proc/config.gz と同じ内容）。OpenIRD のカーネルは同ディレクトリの linux.config
# （それを出発点にしたもの）で建てる。build-yb1-kmod.sh はベンダカーネル向けなので、
# 実機から取った設定を引数で受ける。

# --- MIPS BE クロスツールチェーン（kernel.org crosstool・公開） ---
# sha256 は同ディレクトリの sha256sums.asc と照合済み（2026-09-21）。
# ARM 側（br-ext-chip-fujitsu）と同じ gcc 4.9.4 系に揃えてある。
TOOLCHAIN_URL=https://mirrors.edge.kernel.org/pub/tools/crosstool/files/bin/x86_64/4.9.4/x86_64-gcc-4.9.4-nolibc-mips-linux.tar.xz
TOOLCHAIN_TARBALL=x86_64-gcc-4.9.4-nolibc-mips-linux.tar.xz
TOOLCHAIN_SHA256=47c085b44945eee76aa4e9967bf2f69c57a0b9de03896121b88f8e57afd9cfe9
CROSS_COMPILE_SUBPATH=gcc-4.9.4-nolibc/mips-linux/bin/mips-linux-

# --- 旧 cross-gcc が要するホスト lib（libmpfr.so.4 = MPFR 3.x。Debian archive・公開） ---
HOSTLIB_URL=http://archive.debian.org/debian/pool/main/m/mpfr4/libmpfr4_3.1.5-1_amd64.deb
HOSTLIB_DEB=libmpfr4_3.1.5-1_amd64.deb
HOSTLIB_SHA256=95730a4709b898ffaf677f9b3ab6f6ebef5a96866589a8cf5f775448b3413a98
HOSTLIB_GLOB="usr/lib/x86_64-linux-gnu/libmpfr.so.4*"

# --- カーネルに組み込む OpenIRD のドライバ（scripts/kernel-overlay.sh が drivers/ird/ へ重ねる） ---
KERNEL_DRIVER_DIRS="br-ext-common/package/ird-tuner-core/src br-ext-chip-renesas/package/ird-tuner-mxl683/src br-ext-chip-renesas/package/ird-tuner-emma3sep/src br-ext-chip-renesas/package/ird-board-emma3sep/src"
# --- カーネルに埋め込む救助用 initramfs（make BOARD=… が output/<BOARD>/images/ に作る） ---
# ★ 容量の制約（実機でブリックを踏んで判明・2026-10-10）: ブートローダは NAND の
#    uImage を 0x82000000 に置き、gunzip で load 0x82280000 へ展開する。uImage が
#    その差 0x280000（2,621,440 B）を超えると、展開の出力が自分の未読の圧縮ソースを
#    上書きして起動しない（CRC は通るので気づきにくい）。いまの救助 initramfs
#    （フルの BusyBox 入り rescue.cpio ≈1.37MB）を積むと uImage が約 2.78MB になり
#    この境界を越える。∴ 既定では埋め込まない。preinit の read-only フォールバックが
#    壊れた overlay からの起動を救い、factory イメージは pack-rootfs が squashfs を検証する。
#    救助 initramfs を積み直すには専用の最小 BusyBox で rescue.cpio を小さくすること
#    （follow-up）。openird-mkimage は上限超過の uImage を生成時に弾く。
# KERNEL_INITRAMFS=images/rescue.cpio
