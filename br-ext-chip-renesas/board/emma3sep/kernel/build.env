# SPDX-License-Identifier: GPL-2.0-only
# emma3sep（POE-BR100-YB1）の再現ビルドの固定物。
# scripts/build-yb1-kmod.sh が `.` で読む（カーネルモジュールのビルド）。
# カーネル本体（uImage）の再現ビルドはまだ配線していない。
# 値にスペース/括弧/グロブを含むものは必ずクォートする。

ARCH=mips
KERNEL_VERSION=2.6.27.39
KERNEL_TOP=linux-2.6.27.39
# openird-mkimage の board 名（host/openird-mkimage/boards/<MKIMAGE_BOARD>.json）
MKIMAGE_BOARD=poe-br100-yb1

# --- GPL カーネルソース（非公開直リンク。各自 Pixela の GPL/OSS 提供で入手し dl/ へ） ---
KERNEL_TARBALL=Linux_kernel_2.6.27.39_r557_001.001.008-r06.tar.bz2
KERNEL_SHA256=58c2259121c90191c92da2879b674d73cf34f59d224e24b8da3ef988719273f6
KERNEL_SRC_NOTE="GPL source for POE-BR100-YB1 (Pixela). Obtain via Pixela GPL/OSS request and place it in dl/. Integrity is pinned by KERNEL_SHA256."
# ビルド設定は実機から取る（`gzip -dc /proc/config.gz`）。GPL ドロップに emma3sep の
# defconfig が無く、vermagic と構造体配置を合わせるには実機の設定そのものが要るため。
# ベンダ由来なので repo には置かない。

# --- MIPS BE クロスツールチェーン（kernel.org crosstool・公開） ---
# sha256 は同ディレクトリの sha256sums.asc と照合済み（2026-09-21）。
# ARM 側（br-ext-chip-fujitsu）と同じ gcc 4.9.4 系に揃えてある。
TOOLCHAIN_URL=https://mirrors.edge.kernel.org/pub/tools/crosstool/files/bin/x86_64/4.9.4/x86_64-gcc-4.9.4-nolibc-mips-linux.tar.xz
TOOLCHAIN_TARBALL=x86_64-gcc-4.9.4-nolibc-mips-linux.tar.xz
TOOLCHAIN_SHA256=47c085b44945eee76aa4e9967bf2f69c57a0b9de03896121b88f8e57afd9cfe9
CROSS_COMPILE_SUBPATH=gcc-4.9.4-nolibc/mips-linux/bin/mips-linux-

# --- 旧 cross-gcc が要するホスト lib（libmpfr.so.4 = MPFR 3.x。Debian archive・公開） ---
HOSTLIB_URL=http://archive.debian.org/debian/pool/main/m/mpfr4/libmpfr4_3.1.5-1_amd64.deb
HOSTLIB_DEB=libmpfr4_3.1.5-1_amd64.deb
HOSTLIB_SHA256=95730a4709b898ffaf677f9b3ab6f6ebef5a96866589a8cf5f775448b3413a98
HOSTLIB_GLOB="usr/lib/x86_64-linux-gnu/libmpfr.so.4*"
