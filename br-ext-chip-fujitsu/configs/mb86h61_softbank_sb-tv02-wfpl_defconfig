# OpenIRD: SB-TV02-WFPL（Fujitsu MB86H61, ARM1176 ARMv6 LE）本番 rootfs
# ビルド: make BOARD=mb86h61_softbank_sb-tv02-wfpl
# 出力:   output/<BOARD>/images/openird-sb-tv02-wfpl-rootfs.squashfs（mtd6 用）
#
# 段階A v1 の中身: overlayfs root（squashfs mtd6 + jffs2 mtd7）／SSH(dropbear)／
# ネットワーク／mtd。チューナは段階C（Milestone 2）で足す。
# Milestone 1 の間は観察用ツール（strace / tcpdump / gdbserver）も入れている。
# カーネルは別建て（make kernel BOARD=…＝検証済み像の再現ビルド）。区画は
# board/mb86h61/kernel/patches/0015-*.patch のレイアウト。

# --- アーキテクチャ / toolchain（Bootlin 公式 fragment のとおり） ---
BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://toolchains.bootlin.com/downloads/releases/toolchains/armv5-eabi/tarballs/armv5-eabi--musl--stable-2026.08-1.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_DEBUG=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_NPTL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y

# --- ダウンロードの完全性（全ソースを .hash で検証） ---
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_IRD_FUJITSU_PATH)/board/mb86h61/patches"

BR2_OPTIMIZE_S=y

# --- system ---
BR2_TARGET_GENERIC_HOSTNAME="openird"
BR2_TARGET_GENERIC_ISSUE="OpenIRD"
BR2_INIT_BUSYBOX=y
# 2.6.31 は devtmpfs 無し → 静的 /dev（mtd4–15 を追加）
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_ROOTFS_STATIC_DEVICE_TABLE="system/device_table_dev.txt $(BR2_EXTERNAL_IRD_FUJITSU_PATH)/board/mb86h61/device_table_dev.txt"
# / は preinit が組み立てる overlayfs。squashfs の remount も getty も使わない
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_IRD_FUJITSU_PATH)/board/mb86h61/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_IRD_FUJITSU_PATH)/board/mb86h61/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_IRD_FUJITSU_PATH)/board/mb86h61/post-image.sh"

# --- packages ---
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IRD_FUJITSU_PATH)/board/mb86h61/busybox.fragment"
# ネットワークは ird-base-files の S40network（フォールバック IP → DHCP）
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_IRD_BASE_FILES=y
BR2_PACKAGE_OPENWRT_MTD=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y

# --- Milestone 1 の観察用: ベンダ受信部品の syscall・ioctl・通信を見る ---
# 配布イメージに要るものではない。観察が済んだら外すか、開発用の構成に分ける。
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_TCPDUMP=y
# gdbserver は toolchain 同梱品（ホスト側は同梱の arm-linux-gdb 16.3 と対）
BR2_TOOLCHAIN_EXTERNAL_GDB_SERVER_COPY=y
# BR2_PACKAGE_IRD_TUNER_TC90532=y  # 段階C（Milestone 2）で有効化

# --- rootfs 像（2.6.31 の squashfs は gzip のみ・xattr 非対応） ---
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
