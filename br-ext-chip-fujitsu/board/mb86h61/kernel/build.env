# SPDX-License-Identifier: GPL-2.0-only
# mb86h61 カーネル再現ビルドの固定物（scripts/build-kernel.sh が `.` で読む shell 変数）。
# clone した人が機能的に等価な起動可能カーネル(mtd5 イメージ)を再現するための pin。
# 値にスペース/括弧/グロブを含むものは必ずクォートする。

ARCH=arm
KERNEL_VERSION=2.6.31.6-rt19
KERNEL_IMAGE_TARGET=Image
KERNEL_TOP=kernel
# openird-mkimage の board 名（host/openird-mkimage/boards/<MKIMAGE_BOARD>.json）。
# BOARD(defconfig 名)=mb86h61_softbank_sb-tv02-wfpl とは別の短縮キー。
MKIMAGE_BOARD=sb-tv02-wfpl

# --- GPL カーネルソース（非公開直リンク。各自 Pixela の GPL/OSS 提供で入手し dl/ へ） ---
KERNEL_TARBALL=Linux_kernel_2.6.31.6-rt19_r631_01.00.0002.tar.bz2
KERNEL_SHA256=befbcf187cb815674a168d90225a14c47601455f33b5658209d36253c9790906
KERNEL_SRC_NOTE="GPL source for SB-TV02-WFPL (Pixela). Obtain via Pixela GPL/OSS request and place it in dl/. Integrity is pinned by KERNEL_SHA256."
# 展開時に除外する Fujitsu proprietary FAPex/FAPI シンボリックリンク（FAPex は積まない）
KERNEL_EXTRACT_EXCLUDE="kernel/drivers/media/fapi_driver kernel/drivers/media/fapex"

# --- ARM クロスツールチェーン（kernel.org crosstool・公開） ---
TOOLCHAIN_URL=https://mirrors.edge.kernel.org/pub/tools/crosstool/files/bin/x86_64/4.9.4/x86_64-gcc-4.9.4-nolibc-arm-linux-gnueabi.tar.xz
TOOLCHAIN_TARBALL=x86_64-gcc-4.9.4-nolibc-arm-linux-gnueabi.tar.xz
TOOLCHAIN_SHA256=df4bbafb808f6d55dbcb983904193a54a90825153a355e74717fff9a30161630
CROSS_COMPILE_SUBPATH=gcc-4.9.4-nolibc/arm-linux-gnueabi/bin/arm-linux-gnueabi-

# --- 旧 cross-gcc が要するホスト lib（libmpfr.so.4 = MPFR 3.x。Debian archive・公開） ---
HOSTLIB_URL=http://archive.debian.org/debian/pool/main/m/mpfr4/libmpfr4_3.1.5-1_amd64.deb
HOSTLIB_DEB=libmpfr4_3.1.5-1_amd64.deb
HOSTLIB_SHA256=95730a4709b898ffaf677f9b3ab6f6ebef5a96866589a8cf5f775448b3413a98
HOSTLIB_GLOB="usr/lib/x86_64-linux-gnu/libmpfr.so.4*"

# --- kABI テスト（tests/kabi）の比較基準＝ベンダ出荷カーネル相当のツリー ---
# ビルドを通すためだけのパッチ（構造体に触れない）。基準のツリーにはこれだけを当てる。
KABI_REF_PATCHES="0001-media-drop-fujitsu-fapex-proprietary-hooks.patch 0002-timeconst-fix-defined-array-for-modern-perl.patch"
# 基準の設定＝tarball 同梱のベンダ .config（KERNEL_TOP からの相対）
KABI_REF_CONFIG=.config
