# /etc/inittab - OpenIRD first-aid rootfs (BusyBox init)
#
# The first-aid image never touches MTD on its own: all it does at boot is
# mount the pseudo filesystems.  Flash access and network setup are typed in
# by hand on the serial console.  / stays read-only (squashfs); anything that
# needs to be writable is a tmpfs (/tmp, /run, /dev/shm).

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# Root shell straight on the serial console - no login prompt (recovery tool)
ttyAMA0::respawn:-/bin/sh

::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
