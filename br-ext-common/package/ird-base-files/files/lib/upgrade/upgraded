#!/bin/sh
# /lib/upgrade/upgraded - init's "restart" action (see /etc/inittab).
#
# init executes this in its own place, as PID 1, when it is sent SIGQUIT:
# by then it has run the shutdown actions and killed every other process.
# sysupgrade sends that signal after it has put an image and the tools into
# RAM; this hands PID 1 on to the copy of BusyBox there, so that nothing is
# running from the flash when it is rewritten.
#
# Without a staged upgrade the system is down all the same: restart it.

W=/tmp/sysupgrade

if [ -f "$W/armed" ] && [ -x "$W/bin/busybox" ] && [ -f "$W/lib/stage2" ]; then
	exec "$W/bin/busybox" sh "$W/lib/stage2"
fi

echo "sysupgrade: nothing to do, restarting"
/bin/busybox reboot -f
while :; do /bin/busybox sleep 60; done
