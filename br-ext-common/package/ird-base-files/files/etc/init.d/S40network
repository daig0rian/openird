#!/bin/sh
# OpenIRD network bring-up.
#
# The fallback address is configured first so the device is always reachable at
# a known address, then udhcpc replaces it once a lease arrives.  udhcpc keeps
# running in the background if there is no DHCP server.

IFACE=eth0
FALLBACK_IP=192.168.1.1
FALLBACK_MASK=255.255.255.0
# MAC= in network.conf restores the factory address if the boot loader command
# line lost its mac_adrs= (that command line is the only place it is stored).
MAC=
[ -r /etc/openird/network.conf ] && . /etc/openird/network.conf

start() {
	printf "Starting network: "
	ifconfig lo 127.0.0.1 up
	if [ -n "$MAC" ]; then
		ifconfig "$IFACE" down
		ifconfig "$IFACE" hw ether "$MAC" || echo "(cannot set MAC $MAC) "
	fi
	ifconfig "$IFACE" "$FALLBACK_IP" netmask "$FALLBACK_MASK" up || { echo "FAIL"; exit 1; }
	udhcpc -b -i "$IFACE" -t 4 -T 3 -x "hostname:$(hostname)" \
		-p "/run/udhcpc.$IFACE.pid" >/dev/null 2>&1
	echo "OK"
}

stop() {
	printf "Stopping network: "
	[ -f "/run/udhcpc.$IFACE.pid" ] && kill "$(cat "/run/udhcpc.$IFACE.pid")" 2>/dev/null
	ifconfig "$IFACE" down
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
