# SPDX-License-Identifier: GPL-2.0-only
# QEMU テスト用カーネルに足す設定（アーキ共通）。run.sh が defconfig の後ろに追記する。
# @INITRAMFS_LIST@ は run.sh が images/initramfs.list に置換する。
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@INITRAMFS_LIST@"
CONFIG_OVERLAYFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MTD=y
CONFIG_MTD_CHAR=y
CONFIG_MTD_BLOCK=y
# upper 層: 実機の SPI-NOR に合わせ 16MB / 消去単位 64KB の mtdram 上の jffs2
CONFIG_MTD_MTDRAM=y
CONFIG_MTDRAM_TOTAL_SIZE=16384
CONFIG_MTDRAM_ERASE_SIZE=64
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_FS_WRITEBUFFER=y
CONFIG_JFFS2_FS_XATTR=y
CONFIG_JFFS2_FS_POSIX_ACL=y
CONFIG_JFFS2_FS_SECURITY=y
# 比較用 upper 層
CONFIG_EXT2_FS=y
CONFIG_EXT2_FS_XATTR=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
# ハング時の診断（diag.sh が SysRq-w を送る）
CONFIG_MAGIC_SYSRQ=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_KALLSYMS=y
CONFIG_DEBUG_BUGVERBOSE=y
