# SPDX-License-Identifier: GPL-2.0-only
# ARCH=arm の機種を QEMU versatilepb（ARM926）で試すための定義。run.sh / diag.sh が読む。
QEMU_SYSTEM=qemu-system-arm
QEMU_MACHINE=versatilepb
QEMU_MEM=256
QEMU_EXTRA="-audio none"
KDEFCONFIG=versatile_defconfig
KCONFIG_TARGET_FRAGMENT=arm-versatile.fragment
KIMAGE=zImage
KIMAGE_PATH=arch/arm/boot/zImage
CONSOLE=ttyAMA0
# __log_buf の物理アドレス = 仮想アドレス - これ（versatile は PAGE_OFFSET=0xc0000000, PHYS_OFFSET=0）
KERNEL_VA_TO_PA=0xc0000000
# QEMU "info registers" から PC / LR を抜く正規表現
QEMU_PC_REGEX='R15=([0-9a-f]{8})'
QEMU_LR_REGEX='R14=([0-9a-f]{8})'
# テスト用の静的 busybox（busybox.net 公式バイナリ, EABI）。dl/ に取得し配布物には含めない。
BUSYBOX_URL=https://busybox.net/downloads/binaries/1.21.1/busybox-armv5l
BUSYBOX_FILE=busybox-1.21.1-armv5l
BUSYBOX_SHA256=514d3d76e49b9e1ef65fb1a3b3ab838925f026632329a057e2e369a99ca67c78
